rules_version = '2';

/*
  Medville Diabetes — Cloud Storage security rules.

  Only marketing imagery lives here: product photography, page pictures and
  the logo. No Protected Health Information is ever written to Storage. If a
  future feature needs to store a document belonging to a patient, it does
  not go under site/, and it is not publicly readable.

  Uploads are restricted to signed-in administrators holding a content role,
  capped at 5 MB, and limited to image content types. The cap matters: hosting
  and storage bandwidth is the one line item that can push the client past the
  0 to 5 USD per month ceiling in Section 7.3 of the agreement.
*/

service firebase.storage {
  match /b/{bucket}/o {

    function role() {
      return request.auth != null ? request.auth.token.get('role', '') : '';
    }

    function hasFeature(feature) {
      let features = request.auth != null ? request.auth.token.get('features', null) : null;
      let marketing = role() == 'marketing' || role() == 'editor';
      let sales = role() == 'sales' || role() == 'agent';
      return role() == 'owner' || ((marketing || sales) && (
        (features is list && feature in features)
        || (features == null && (marketing || (sales && feature == 'products')))
      ));
    }

    function isValidImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif|avif)');
    }

    match /site/{area}/{allPaths=**} {
      allow read: if true;
      allow create, update: if hasFeature(area == 'products' ? 'products' : area == 'blog' ? 'blog' : 'content') && isValidImage();
      allow delete: if hasFeature(area == 'products' ? 'products' : area == 'blog' ? 'blog' : 'content');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
