rules_version = '2';

/*
  Medville Diabetes — Firestore security rules.

  Two worlds live in this database and they are kept strictly apart.

  1. Marketing content (siteContent, siteTheme, products, faqs, testimonials, posts).
     The public website reads these directly. They contain no personal data of
     any kind. Only a signed-in administrator with a content role may write.

  2. Legacy private collections (leads, auditLog). No browser client may
     access these. Current enquiries and their audit history are in AWS
     DynamoDB, accessible only through the audited AWS admin API. The Google
     admin service supplies workforce identity and public content only.

  Roles live in Identity Platform custom claims, not in documents, so a role
  cannot be escalated by writing to Firestore:
    owner     — every feature, including the access log and Owner management
    marketing — every feature except the access log
    sales     — products and enquiries only

  If a change to this file appears to open leads to any client read, it is
  wrong. Route it through the function instead.
*/

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() ? request.auth.token.get('role', '') : '';
    }

    function isOwner() {
      return role() == 'owner';
    }

    function isMarketing() {
      return role() == 'marketing' || role() == 'editor';
    }

    function isSales() {
      return role() == 'sales' || role() == 'agent';
    }

    function hasFeature(feature) {
      let hasCustomFeatures = signedIn() && request.auth.token.keys().hasAny(['features']);
      let features = hasCustomFeatures ? request.auth.token.features : [];
      return (isOwner() || isMarketing() || isSales()) && (isOwner()
        || (features is list && feature in features)
        || (!hasCustomFeatures && (
          (isMarketing() && feature in ['overview', 'leads', 'influencers', 'products', 'content', 'blog', 'appearance', 'faqs', 'testimonials'])
          || (isSales() && feature in ['leads', 'products'])
        )));
    }

    function canEditContent(feature) {
      return hasFeature(feature);
    }

    function canEditTrashKind(kind) {
      return kind in ['products', 'faqs', 'testimonials', 'blog'] && hasFeature(kind);
    }

    function textField(d, key, limit) {
      return !(key in d) || (d[key] is string && d[key].size() <= limit);
    }
    function boolField(d, key) {
      return !(key in d) || d[key] is bool;
    }
    function listField(d, key, limit) {
      return !(key in d) || (d[key] is list && d[key].size() <= limit);
    }
    function orderField(d) {
      return !('order' in d) || (d.order is number && d.order >= -100000 && d.order <= 100000);
    }
    function validProduct(d) {
      return d.keys().hasOnly(['slug','name','brand','line','category','shortDescription','description','keyFacts','imageFront','imageBack','featured','status','price','deleted'])
        && textField(d,'slug',60) && textField(d,'name',160)
        && textField(d,'shortDescription',2000) && textField(d,'imageFront',2048) && textField(d,'imageBack',2048)
        && listField(d,'description',50) && listField(d,'keyFacts',50)
        && boolField(d,'featured') && boolField(d,'deleted')
        && (!('brand' in d) || d.brand in ['FreeStyle Libre','Dexcom','Tandem'])
        && (!('line' in d) || d.line in ['cgm','insulin-pump'])
        && (!('category' in d) || d.category in ['System','Sensor','Accessory'])
        && (!('status' in d) || d.status in ['available','coming-soon','sold'])
        && (!('price' in d) || (d.price is number && d.price >= 0 && d.price <= 1000000));
    }
    function validPost(d) {
      return d.keys().hasOnly(['title','excerpt','body','image','imageAlt','author','publishedAt','published','homeFeatured','template'])
        && textField(d,'title',500) && textField(d,'excerpt',3000)
        && textField(d,'image',2048) && textField(d,'imageAlt',1000)
        && textField(d,'author',160) && textField(d,'publishedAt',40) && textField(d,'template',40)
        && boolField(d,'published') && boolField(d,'homeFeatured') && listField(d,'body',200);
    }

    /* ---- public marketing content ---- */

    match /siteContent/{page} {
      allow read: if true;
      allow write: if canEditContent('content');
    }

    match /siteTheme/{doc} {
      allow read: if true;
      allow write: if canEditContent('appearance');
    }

    match /products/{slug} {
      allow read: if true;
      allow create, update: if hasFeature('products') && validProduct(request.resource.data);
      allow delete: if hasFeature('products');
    }

    match /faqs/{id} {
      allow read: if true;
      allow create, update: if canEditContent('faqs')
        && request.resource.data.keys().hasOnly(['question','answer','order'])
        && textField(request.resource.data,'question',1000)
        && textField(request.resource.data,'answer',10000) && orderField(request.resource.data);
      allow delete: if canEditContent('faqs');
    }

    match /testimonials/{id} {
      allow read: if canEditContent('testimonials') || resource.data.published == true;
      allow create, update: if canEditContent('testimonials')
        && request.resource.data.keys().hasOnly(['quote','name','location','order','published'])
        && textField(request.resource.data,'quote',5000) && textField(request.resource.data,'name',160)
        && textField(request.resource.data,'location',160) && boolField(request.resource.data,'published')
        && orderField(request.resource.data);
      allow delete: if canEditContent('testimonials');
    }

    /* Drafts are private. Filtering only in the browser exposes unpublished copy. */
    match /posts/{slug} {
      allow read: if canEditContent('blog') || resource.data.published == true;
      allow create, update: if canEditContent('blog') && validPost(request.resource.data);
      allow delete: if canEditContent('blog');
    }

    /* Recoverable website content only. Patient enquiries remain in AWS and
       never enter a Firestore document, including this collection. */
    match /dashboardTrash/{id} {
      allow get, list: if canEditTrashKind(resource.data.kind);
      allow create: if canEditTrashKind(request.resource.data.kind)
        && request.resource.data.keys().hasAll(['kind', 'sourceId', 'label', 'deletedAt', 'deletedBy', 'snapshot', 'builtIn'])
        && request.resource.data.keys().hasOnly(['kind', 'sourceId', 'label', 'deletedAt', 'deletedBy', 'snapshot', 'builtIn'])
        && id == request.resource.data.kind + ':' + request.resource.data.sourceId
        && textField(request.resource.data, 'sourceId', 160)
        && textField(request.resource.data, 'label', 500)
        && textField(request.resource.data, 'deletedAt', 40)
        && request.resource.data.deletedBy == request.auth.uid
        && (request.resource.data.snapshot == null || request.resource.data.snapshot is map)
        && request.resource.data.builtIn is bool;
      allow delete: if canEditTrashKind(resource.data.kind);
      allow update: if false;
    }

    /* ---- Protected Health Information ---- */

    match /leads/{id} {
      allow read, write: if false;
    }

    match /auditLog/{id} {
      allow read, write: if false;
    }

    /* Referral links and their counters are written by trusted functions.
       Direct browser writes would let anyone forge campaign results. */
    match /influencers/{id} {
      allow read, write: if false;
    }

    match /attributionVisits/{id} {
      allow read, write: if false;
    }

    match /attributionLimits/{id} {
      allow read, write: if false;
    }

    match /contactLimits/{id} {
      allow read, write: if false;
    }

    /* Blog subscriptions contain email addresses and are handled only by
       trusted functions. They are never public marketing content. */
    match /newsletterSubscriptions/{id} {
      allow read, write: if false;
    }

    match /newsletterLimits/{id} {
      allow read, write: if false;
    }

    /* ---- administrator roster ----
       A display mirror only, so the dashboard can list colleagues without a
       function round trip. The claim is what actually grants access, and the
       function is the only thing that can set it. */

    match /adminUsers/{uid} {
      allow read: if isOwner();
      allow write: if false;
    }

    /* Everything else stays closed. */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
