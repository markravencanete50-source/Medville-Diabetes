# ---------------------------------------------------------------------------
# Medville Diabetes — site environment.
#
# Every value here is safe to expose. A Firebase web API key is an identifier,
# not a secret: access is decided by the Firestore and Storage security rules
# and by the Identity Platform token. Nothing in this file grants access to
# patient information on its own.
#
# Leave any value empty and the feature it powers stays dormant. With an empty
# file the website runs exactly as it was built, and the dashboard explains
# what is missing rather than failing.
# ---------------------------------------------------------------------------

# URL of the deployed qualifyIntake Cloud Run function.
# Empty during design work: the form runs in prototype mode and sends nothing.
VITE_QUALIFY_ENDPOINT=

# URL of the deployed adminApi Cloud Run function.
# Serves the enquiry list, the overview figures and the access log.
VITE_ADMIN_API=

# Identity Platform / Firebase web configuration, from the Google Cloud
# console. Needed for the dashboard login and for live page content.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
